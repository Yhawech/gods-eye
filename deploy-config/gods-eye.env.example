AWS_REGION=ap-south-1
APP_SECRET_ID=/gods-eye/prod/app-env
APP_DIR=/opt/gods-eye
APP_HOST=0.0.0.0
APP_PORT=4173
SERVICE_NAME=gods-eye
RUN_USER=ubuntu
GLOBE_ENABLED=false
GLOBE_REPO_URL=https://github.com/bilawalsidhu/gods-eye-view.git
GLOBE_INSTALL_DIR=/opt/gods-eye/globe
GLOBE_APP_HOST=0.0.0.0
GLOBE_APP_PORT=4174
# Local-only default. For AWS, replace with the public ALB/domain globe route.
GLOBE_VIEW_URL=http://127.0.0.1:4174
GLOBE_OSINT_ENABLED=true
GLOBE_OSINT_REFRESH_MS=300000
GLOBE_OSINT_MAX_ITEMS=80
